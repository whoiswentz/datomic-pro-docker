# ── Datomic ─────────────────────────────────────────────
DATOMIC_VERSION=1.0.7705
# Advertised transactor host — peers must resolve this. On the compose
# network it is the service name. For external peers, set to a reachable
# host and see the README (alt-host).
TRANSACTOR_HOST=datomic
TRANSACTOR_XMX=-Xmx1g
TRANSACTOR_XMS=-Xms1g
# Datomic index/cache — keep consistent with -Xmx (see Datomic capacity docs)
MEMORY_INDEX_THRESHOLD=32m
MEMORY_INDEX_MAX=256m
OBJECT_CACHE_MAX=128m

# ── ScyllaDB storage ────────────────────────────────────
SCYLLA_VERSION=2026.2
SCYLLA_CONTACT_POINTS=scylla
SCYLLA_CQL_PORT=9042
SCYLLA_KEYSPACE=datomic3
SCYLLA_TABLE=datomic3
SCYLLA_DC=datacenter1
SCYLLA_RF=1
# Per-node resources for the dev cluster. Lower these for constrained machines.
SCYLLA_NODE_SMP=2
SCYLLA_NODE_MEMORY=2G

# ── Auth ────────────────────────────────────────────────
# Scylla superuser (used only by datomic-init). On first run datomic-init
# connects with the built-in bootstrap password below, then rotates the
# superuser to CASSANDRA_SUPERUSER_PASSWORD. Change this before production.
CASSANDRA_SUPERUSER=cassandra
CASSANDRA_SUPERUSER_PASSWORD=change-me-scylla-superuser
# Scylla's built-in default superuser password (pre-rotation). Leave as-is
# unless your image ships a different default.
CASSANDRA_SUPERUSER_BOOTSTRAP_PASSWORD=cassandra
# Least-privilege application user Datomic uses.
DATOMIC_DB_USER=datomic3
DATOMIC_DB_PASSWORD=change-me-app-password

# ── TLS ─────────────────────────────────────────────────
CASSANDRA_SSL=true
SCYLLA_REQUIRE_CLIENT_AUTH=true
TRUSTSTORE_PASSWORD=change-me-truststore
KEYSTORE_PASSWORD=change-me-keystore

# ── Example app (examples/clojure) ──────────────────────
EXAMPLE_DB_NAME=example
